NODE_ENV=development
PORT=3800
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:4200,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:4200,http://[::1]:3000,http://[::1]:3001,http://[::1]:4200
# Optional Socket.IO cross-process room broadcast adapter. Does not share game runtime state.
REDIS_URL=
TRUST_PROXY_HOPS=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tu_tien_pixel
DB_USER=root
DB_PASSWORD=
DB_POOL_SIZE=10
DB_QUEUE_LIMIT=100
# Optional; when set, protects GET /metrics with Authorization: Bearer <token>.
METRICS_TOKEN=replace-with-a-random-token-at-least-32-bytes-long
