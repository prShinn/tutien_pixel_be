REDIS_URL=
TRUST_PROXY_HOPS=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tu_tien_pixel
DB_USER=root
DB_PASSWORD=
DB_POOL_SIZE=10
DB_QUEUE_LIMIT=100
